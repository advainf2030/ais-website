# Used only by Apache/LiteSpeed hosts (cPanel, Spaceship); Vercel ignores it.
# Upload the CONTENTS of dist/ (index.html, assets/, logos/ …), not the source.

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  # File names in assets/ carry a content hash, so they can be cached for a year
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must always be re-checked so a new upload shows up at once
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
